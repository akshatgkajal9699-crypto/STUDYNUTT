{
  "expo": {
    "name": "STUDYNUT",
    "slug": "studynut",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/studynut-icon.png",
    "scheme": "studynut",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/studynut-icon.png"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/studynut-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
